	"acceptance_criteria": [
		{
			"id": "AC-RESERVATION-002",
			"title": "그날의 예약을 시작 시각순으로 돌려준다",
			"gherkin": {
				"given": [
					"수용 인원 6명인 회의실 1 이 있다",
					"회의실 1 의 2026-11-17 에 예약 A(14:00~15:00, 제목 '주간 회의', 예약자 E200)와 예약 B(10:00~11:00, 제목 '설계 리뷰', 예약자 E100)가 있다"
				],
				"when": "직원 E100 이 GET /api/rooms/1/reservations?date=2026-11-17 을 호출한다",
				"then": [
					"200 응답",
					"본문 배열의 순서는 예약 B, 예약 A 다",
					"항목마다 startTime, endTime, reservedBy, title 이 있다"
				]
			},
			"severity": "must",
			"verifiable": true,
			"automated_runnable": true,
			"layer": "be",
			"openapi_path": "/api/rooms/{roomId}/reservations",
			"operationId": "listReservations"
		},
